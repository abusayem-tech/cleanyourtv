<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for TV Bro as "Browser": chrome-blue field with a globe. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF0B4FBF"
                android:startColor="#FF1A9BFF" />
        </shape>
    </item>
    <item
        android:width="84dp"
        android:height="84dp"
        android:drawable="@drawable/ic_browser"
        android:gravity="center" />
</layer-list>
