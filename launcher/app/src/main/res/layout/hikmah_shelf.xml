<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hikmah"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/hikmah_panel_bg"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:importantForAccessibility="no"
    android:nextFocusDown="@id/grid"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="18dp"
    android:paddingEnd="28dp"
    android:paddingBottom="18dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hikmahKicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/hikmahDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/hikmahTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@string/font_light"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/hikmahBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@string/font_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
